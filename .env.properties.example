# ─────────────────────────────────────────────────────────────
# KoALa-back 로컬 개발 환경 변수 예시
# 이 파일을 복사하여 .env.properties 로 만들고 실제 값을 채워주세요.
# .env.properties 는 .gitignore 에 포함되어 있으므로 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 ──────────────────────────────────────────────
DB_USERNAME=root
DB_PASSWORD=your-local-db-password

# ── JWT ───────────────────────────────────────────────────────
# 최소 256비트(32자) 이상의 무작위 시크릿 키를 사용하세요.
JWT_SECRET=your-very-long-random-jwt-secret-key-at-least-32-characters

# ── 이메일 (Gmail SMTP) ───────────────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── OAuth2 ────────────────────────────────────────────────────
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── AWS S3 ────────────────────────────────────────────────────
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# ── 결제 (Toss Payments) ──────────────────────────────────────
TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_WEBHOOK_SECRET=your-toss-webhook-secret

# ── 슬랙 주문 알림 ────────────────────────────────────────────
# api.slack.com/apps > Incoming Webhooks 에서 발급
# url 을 아는 사람은 누구나 그 채널에 글을 쓸 수 있다 — 저장소에 넣지 말 것
KOALA_SLACK_ENABLED=false
KOALA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# 이 웹훅 하나로 새 주문 · 반품 신청 · 결제 미확정 · 수동 환불 · 재고 소진 ·
# 서버 기동 · 500 오류가 모두 나간다. 채널을 나누려면 알림 종류별로
# SlackNotifier 를 하나 더 두면 된다.

# ── 500 오류 알림 폭주 억제 ───────────────────────────────────
# 500 은 하나씩 오지 않는다. DB 커넥션이 마르면 같은 예외가 초당 수십 건 터진다.
# 그대로 두면 채널이 잠겨 정작 중요한 주문·환불 알림이 묻힌다.
#   error-cooldown-ms  : 같은 오류(예외 종류 + 경로)를 다시 알리기까지의 간격
#   error-max-per-hour : 서로 다른 오류까지 합친 시간당 총 상한
KOALA_ALERT_ERROR_COOLDOWN_MS=600000
KOALA_ALERT_ERROR_MAX_PER_HOUR=20

# ── 배송 자동 추적 (스윗트래커) ───────────────────────────────
# 켜면 배송 중 주문의 운송장을 주기적으로 조회해 '배송완료'로 자동 전환한다.
# 끄면 지금처럼 어드민에서 직접 눌러야 한다.
#
# 키 발급: tracking.sweettracker.co.kr — 무료 플랜은 일일 호출 수 제한이 있다.
# 운송장 등록 시 택배사를 목록에서 골라야 조회가 된다(자유 입력은 조회 불가).
KOALA_DELIVERY_TRACKING_ENABLED=false
KOALA_DELIVERY_TRACKING_API_KEY=
# 조회 주기 (기본 30분). 택배사 스캔이 몇 시간 단위로 올라와 더 자주 돌 이유가 없다
KOALA_DELIVERY_TRACKING_SCAN_INTERVAL_MS=1800000
# 이 기간이 지나도 배송완료로 안 잡히면 폴링을 멈춘다 — 손으로 정리한다
KOALA_DELIVERY_TRACKING_MAX_AGE_DAYS=30

# ── 나이스페이먼츠 (PG 전환) ───────────────────────────────────
# enabled=false 면 나이스 관련 빈이 전부 뜨지 않고 토스가 그대로 동작한다.
# 키를 받아 넣고 true 로 바꾸는 순간부터 나이스로 결제된다.
#
# 키 발급: start.nicepay.co.kr — 테스트 상점 가입 후 즉시 발급
# 샌드박스: https://sandbox-api.nicepay.co.kr/v1
NICEPAY_ENABLED=false
NICEPAY_API_BASE=https://sandbox-api.nicepay.co.kr/v1
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=

# 결제창에서 돌아온 뒤 브라우저를 보낼 곳
KOALA_WEB_BASE_URL=https://koala-art.co.kr
