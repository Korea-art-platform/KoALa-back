#!/bin/sh
#
# 커밋 전 시크릿 차단 훅
#
# 설치:  git config core.hooksPath .githooks
#
# 규칙은 scan-secrets.sh 한 곳에 있고, CI 도 같은 스크립트를 쓴다.
# 스테이징된 "추가된 줄"과 "파일 이름"만 보므로 커밋마다 비용이 거의 없다.
#
# 긴급히 우회해야 하면 git commit --no-verify 를 쓸 수 있지만,
# 그 커밋은 CI 의 시크릿 검사에서 다시 걸린다.

set -u

dir="$(dirname "$0")"
exec sh "$dir/scan-secrets.sh" --staged
