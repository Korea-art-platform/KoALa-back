#!/bin/sh
#
# 커밋 전 시크릿 차단 훅
#
# 설치:  git config core.hooksPath .githooks
#
# 스테이징된 "추가된 줄"과 "파일 이름"만 검사한다. 저장소 전체를 훑지 않으므로
# 커밋마다 비용이 거의 없다. CI 의 gitleaks 와 같은 패턴을 보도록 맞춰 두었다
# (.gitleaks.toml). 둘 중 하나만 고치면 어긋나므로 항상 같이 고친다.
#
# 긴급히 우회해야 하면 git commit --no-verify 를 쓸 수 있지만,
# 그 커밋은 CI 의 gitleaks 잡에서 다시 걸린다.

set -u

RED=''; YEL=''; RST=''
if [ -t 2 ]; then RED="$(printf '\033[31m')"; YEL="$(printf '\033[33m')"; RST="$(printf '\033[0m')"; fi

fail=0
note() { printf '%s\n' "$*" >&2; }

# ── 검사에서 제외할 경로 ────────────────────────────────────────────────────
# 템플릿(*.example)은 자리표시자만 들어 있으므로 내용 검사를 하지 않는다.
# 훅과 gitleaks 설정 자체는 패턴 문자열을 담고 있어 제외한다.
is_allowlisted() {
    case "$1" in
        *.example) return 0 ;;
        .gitleaks.toml|.githooks/*) return 0 ;;
    esac
    return 1
}

# ── 1. 파일 이름 자체가 금지된 것들 ─────────────────────────────────────────
# 내용과 무관하게 이런 파일은 저장소에 들어오면 안 된다.
check_forbidden_name() {
    base="${1##*/}"
    case "$base" in *.example) return 0 ;; esac
    case "$base" in
        .env|.env.*) return 1 ;;
        application-local.yml|application-local.yaml) return 1 ;;
        application-prod.yml|application-prod.yaml) return 1 ;;
        application.properties|application-*.properties) return 1 ;;
        keystore.properties) return 1 ;;
        firebase-service-account.json) return 1 ;;
        *.jks|*.keystore) return 1 ;;
        *.pem|*.p12|*.pfx) return 1 ;;
        id_rsa|id_dsa|id_ecdsa|id_ed25519) return 1 ;;
    esac
    return 0
}

staged_files="$(git diff --cached --name-only --diff-filter=ACM)"

for f in $staged_files; do
    if ! check_forbidden_name "$f"; then
        note "${RED}[차단] 커밋하면 안 되는 파일입니다:${RST} $f"
        fail=1
    fi
done

# ── 2. 추가된 줄의 내용 검사 ────────────────────────────────────────────────
# 패턴은 .gitleaks.toml 의 규칙과 1:1 로 대응한다.
scan_content() {
    f="$1"
    # 바이너리는 건너뛴다 (numstat 이 "-  -" 로 나온다)
    if git diff --cached --numstat -- "$f" | awk '$1=="-" && $2=="-" {found=1} END {exit !found}'; then
        return 0
    fi
    added="$(git diff --cached -U0 -- "$f" | sed -n 's/^+//p' | grep -v '^++')"
    [ -n "$added" ] || return 0

    hit=""
    m() {
        if printf '%s\n' "$added" | grep -Eq -e "$1"; then
            hit="${hit}${hit:+, }$2"
        fi
    }

    m 'A(KIA|SIA)[0-9A-Z]{16}'                                            'AWS 액세스 키'
    m '-----BEGIN[ A-Z]*PRIVATE KEY-----'                                 '개인키'
    m '(test|live)_(sk|ak)_[0-9A-Za-z]{10,}'                              '결제 시크릿 키'
    m 'AIza[0-9A-Za-z_-]{35}'                                             '구글 API 키'
    m 'xox[baprs]-[0-9A-Za-z-]{10,}'                                      '슬랙 토큰'
    m 'hooks\.slack\.com/services/[0-9A-Za-z/+_-]{20,}'                   '슬랙 웹훅 URL'
    m 'eyJ[0-9A-Za-z_-]{10,}\.[0-9A-Za-z_-]{10,}\.[0-9A-Za-z_-]{10,}'     'JWT 토큰'

    if [ -n "$hit" ]; then
        note "${RED}[차단] 시크릿으로 보이는 값이 있습니다:${RST} $f  (${hit})"
        fail=1
    fi
}

for f in $staged_files; do
    is_allowlisted "$f" && continue
    scan_content "$f"
done

if [ "$fail" -ne 0 ]; then
    note ""
    note "${YEL}커밋을 중단했습니다.${RST}"
    note "  1) 값을 코드에서 빼고 환경변수(.env.properties)나 GitHub Secrets 로 옮기세요."
    note "  2) 이미 스테이징했다면:  git restore --staged <파일>"
    note "  3) 실제 시크릿이 아니라 자리표시자라면 파일 이름을 *.example 로 두세요."
    note ""
    note "정말 예외라면 git commit --no-verify 로 우회할 수 있지만,"
    note "CI 의 gitleaks 잡에서 같은 패턴으로 다시 걸립니다."
    exit 1
fi

exit 0
